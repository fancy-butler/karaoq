{
  "name": "karaoq",
  "version": "0.13.8",
  "description": "Party karaoke: YouTube karaoke with a shared queue fed from everyone's phones. No ads.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "mock": "MOCK=1 node server.js",
    "smoke": "node scripts/smoke.js",
    "app": "electron .",
    "fetch-binaries": "node scripts/fetch-binaries.js",
    "dist": "electron-builder --publish never",
    "lint": "eslint .",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "yauzl": "^3.4.0"
  },
  "homepage": "https://github.com/fancy-butler/karaoq",
  "author": "fancy-butler",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.5",
    "ffmpeg-static": "^5.3.0",
    "globals": "^15.15.0",
    "puppeteer-core": "^25.17.0"
  },
  "build": {
    "appId": "app.karaoq",
    "productName": "KARAO-Q",
    "artifactName": "KARAO-Q-${version}-${os}-${arch}.${ext}",
    "asar": false,
    "files": [
      "server.js",
      "lib/**",
      "public/**",
      "assets/**",
      "desktop/**",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "bin/${os}-${arch}",
        "to": "bin"
      }
    ],
    "icon": "assets/icon-1024.png",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "synopsis": "Party karaoke with a shared phone queue",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KARAO-Q"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "identity": "-",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "KARAO-Q plays your microphones through the speakers along with the song."
      },
      "hardenedRuntime": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fancy-butler",
        "repo": "karaoq",
        "releaseType": "release"
      }
    ]
  },
  "desktopName": "karaoq.desktop"
}
