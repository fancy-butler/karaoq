{
  "name": "karaoq",
  "version": "0.6.0",
  "description": "Party karaoke: YouTube karaoke with a shared queue fed from everyone's phones. No ads.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "mock": "MOCK=1 node server.js",
    "app": "electron .",
    "fetch-binaries": "node scripts/fetch-binaries.js",
    "dist": "electron-builder --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "electron-updater": "^6.8.11"
  },
  "homepage": "https://github.com/fancy-butler/karaoq",
  "author": "fancy-butler",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.0",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "app.karaoq",
    "productName": "KARAO-Q",
    "artifactName": "KARAO-Q-${version}-${os}-${arch}.${ext}",
    "asar": false,
    "files": [
      "server.js",
      "lib/**",
      "public/**",
      "assets/**",
      "desktop/**",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "bin/${os}-${arch}",
        "to": "bin"
      }
    ],
    "icon": "assets/icon-1024.png",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "synopsis": "Party karaoke with a shared phone queue",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KARAO-Q"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "identity": null
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fancy-butler",
        "repo": "karaoq",
        "releaseType": "release"
      }
    ]
  },
  "desktopName": "karaoq.desktop"
}
